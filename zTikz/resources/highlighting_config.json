{
    "commands": {
        "pattern": "\\\\[a-zA-Z]+\\*?",
        "color": "#0000FF",
        "bold": true
    },
    "braces": {
        "pattern": "[{}]",
        "color": "#0000FF"
    },
    "numbers": {
        "pattern": "\\b\\d+\\b",
        "color": "#009900"
    },
    "comments": {
        "pattern": "%.*",
        "color": "#999999",
        "italic": true
    },
    "keywords": {
        "pattern": "\\b(begin|end|draw|node|foreach|if|then|else)\\b",
        "color": "#CC0000",
        "bold": true
    },
    "environments": {
        "pattern": "\\\\(begin|end)\\{[a-zA-Z]+\\}",
        "color": "#AA00AA",
        "italic": true
    },
    "operators": {
        "pattern": "[\\+\\-\\*\\/\\=]",
        "color": "#FF8800"
    },
    "node_content": {
        "color": "#CC6600"
    }
}